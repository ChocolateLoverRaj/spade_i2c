# top = i2c_controller_th

import cocotb
from cocotb.clock import Clock
from cocotb.triggers import FallingEdge, RisingEdge
from spade import SpadeExt

async def setup(dut):
    s = SpadeExt(dut)
    clk = dut.clk

    # 1. Start 10 MHz clock (100 ns period)
    cocotb.start_soon(Clock(clk, 100, unit="ns").start())

    s.i.rst = False
    s.i.sda_low = False
    s.i.scl_low = False
    s.i.request._data = "None"
    s.i.config.start_hold_cycles = 6;
    s.i.config.data_hold_cycles = 3;
    s.i.config.data_setup_cycles = 1;
    s.i.config.scl_low_cycles = 13;
    s.i.config.scl_high_cycles = 6;
    s.i.config.clock_cycle_cycles = 25;
    s.i.config.stop_setup_cycles = 6;
    s.i.config.after_stop_cycles = 13;

    s.i.rst = True
    await FallingEdge(clk)
    s.i.rst = False
    await FallingEdge(clk)

    return (s, clk)

@cocotb.test()
async def idle(dut):
    (s, _clk) = await setup(dut)

    s.o.sda_low.assert_eq(False)
    s.o.scl_low.assert_eq(False)
    s.o.status.assert_eq("None")
    s.i.request.ready.assert_eq(True)

@cocotb.test()
async def write(dut):
    (s, clk) = await setup(dut)
    sda = dut.sda;
    scl = dut.scl;

    addr = 0x3C;

    s.i.request._data = f"Some(Request::StartWrite{{addr:{addr}}})"
    s.o.sda_low.assert_eq(False)
    s.o.scl_low.assert_eq(False)
    s.o.status.assert_eq("None")
    s.i.request.ready.assert_eq(True)
