mod by_bit;
mod config;

use std::conv::concat_arrays;
use by_bit::i2c_controller_by_bit;
use ready_valid::Rv;
pub use config::Config;

pub struct Output {
    // If `true`, leave as input
    // If `false`, drive low
    sda: bool,
    // If `true`, leave as input
    // If `false`, drive low
    scl: bool,

    status: Option<Status>,
}

pub enum Rw {
    Read,
    Write,
}

pub enum Addr {
    _7Bit { addr: uint<7> },
    _10Bit { addr: uint<10> },
}

pub struct AddrRw {
    addr: Addr,
    rw: Rw,
}

impl AddrRw {
    fn byte_0(self) -> uint<8> {
        let rw_bit = match self.rw {
            Rw::Read => true,
            Rw::Write => false,
        };
        match self.addr {
            Addr::_7Bit(addr) => {
                concat_arrays([rw_bit], addr.as_bits()).as_uint()
            },
            Addr::_10Bit(addr) => {
                [rw_bit, addr.as_bits()[8], addr.as_bits()[9], false, true, true, true, true].as_uint()
            }
        }
    }

    fn byte_1(self) -> uint<8> {
        match self.addr {
            Addr::_10Bit(addr) => {
                trunc(addr)
            },
            // unreachable
            _ => 0,
        }
    }
}

pub enum Req {
    // `status` will be `Some(Status::Nack)` or `Some(Status::Ack)` on 1 clock on or before ready = true.
    Start { addr_rw: AddrRw },
    // `status` will be `Some(Status::Nack)` or `Some(Status::Ack)` on 1 clock on or before ready = true.
    WriteByte { byte: uint<8> },
    // `status` will be `Some(Status::ReadByte { byte: _ })` on 1 clock on or before ready = true,
    ReadByte { is_last: bool },
    // `status` will be `Some(Status::Nack)` or `Some(Status::Ack)` on 1 clock on or before ready = true.
    Restart { addr_rw: AddrRw },
    Stop,
}

pub enum Status {
    // Didn't receive ACK. This means that the target doesn't exist or didn't respond.
    Nack,
    Ack,
    ReadByte { byte: uint<8> }
}

struct StartStateSendAddr {
    byte_i: uint<1>,
    // 8 means we wrote 8 bits and will now receive ack/nack
    bit_i: uint<4>,
    received_nack: bool,
}

enum StartState {
    Start,
    SendAddr { state: StartStateSendAddr }
}

enum State {
    Idle,
    Start { state: StartState },
    WriteByte {
        // 8 means we wrote the 8 bits and will now receive ack/nack
        i: uint<4>
    },
    ReadByte {
        // We construct this by setting bit 0 and then shifting left
        byte: uint<8>,
        // 8 means we read the 8 bits and will now send an ACK (if not last) or NACK (if last)
        i: uint<4>
    },
    Restart { state: StartState },
    Stop,
}

struct S<#uint N> {
    req: Option<by_bit::Req>,
    ready: bool,
    status: Option<Status>,
    next_state: State,
}

struct StartS<#uint N> {
    req: Option<by_bit::Req>,
    ready: bool,
    status: Option<Status>,
    next_state: Option<StartState>,
}

fn s_start_common<#uint N>(config: Config<N>, ready: bool, read_bit: Option<bool>, addr_rw: AddrRw, state: StartState, start_req: by_bit::Req) -> StartS<N> {
    match state {
        StartState::Start => StartS {
            req: Some(start_req),
            ready: false,
            status: None,
            next_state: Some(if ready {
                StartState::SendAddr(StartStateSendAddr(0, 0, false))
            } else {
                StartState::Start
            }),
        },
        StartState::SendAddr(StartStateSendAddr(byte_i, bit_i, received_nack)) => {
            let last_byte = match addr_rw.addr {
                Addr::_7Bit(_) => 0,
                Addr::_10Bit(_) => 1,
            };
            let is_last_byte = byte_i == last_byte;
            let received_nack = received_nack || match read_bit {
                Some(true) => true,
                _ => false,
            };
            StartS {
                req: Some(match (byte_i, bit_i) {
                    (_, 8) => by_bit::Req::ReadBit,
                    (0, bit_i) => by_bit::Req::WriteBit(addr_rw.byte_0().as_bits()[7 -. trunc(bit_i)]),
                    (1, bit_i) => by_bit::Req::WriteBit(addr_rw.byte_1().as_bits()[7 -. trunc(bit_i)]),
                }),
                ready: (is_last_byte || received_nack) && bit_i == 8 && ready,
                status: match (is_last_byte || received_nack, read_bit) {
                    (true, Some(true)) => Some(Status::Nack),
                    (true, Some(false)) => Some(Status::Ack),
                    _ => None
                },
                next_state: match (is_last_byte || received_nack, bit_i, ready) {
                    (true, 8, true) => None,
                    (_, 8, true) => Some(StartState::SendAddr(StartStateSendAddr(byte_i +. 1, 0, received_nack))),
                    (_, bit_i, true) => Some(StartState::SendAddr(StartStateSendAddr(byte_i, bit_i +. 1, received_nack))),
                    _ => Some(StartState::SendAddr(StartStateSendAddr(byte_i, bit_i, received_nack))),
                },
            }
        }
    }
}

fn s_start<#uint N>(config: Config<N>, ready: bool, read_bit: Option<bool>, addr_rw: AddrRw, state: StartState) -> S<N> {
    let s = s_start_common(config, ready, read_bit, addr_rw, state, by_bit::Req::Start);
    S {
        req: s.req,
        ready: s.ready,
        status: s.status,
        next_state: match s.next_state {
            Some(start_state) => State::Start(start_state),
            None => State::Idle
        },
    }
}

fn s_write_byte<#uint N>(config: Config<N>, ready: bool, read_bit: Option<bool>, byte: uint<8>, i: uint<4>) -> S<N> {
    if i < 8 {
        S {
            req: Some(by_bit::Req::WriteBit(byte.as_bits()[7 -. trunc(i)])),
            ready: false,
            status: None,
            next_state: if !ready {
                State::WriteByte(i)
            } else {
                State::WriteByte(i +. 1)
            },
        }
    } else {
        S {
            req: Some(by_bit::Req::ReadBit),
            ready,
            status: match read_bit {
                Some(true) => Some(Status::Nack),
                Some(false) => Some(Status::Ack),
                None => None,
            },
            next_state: if ready {
                State::Idle
            } else {
                State::WriteByte(i)
            }
        }
    }
}

fn s_read_byte<#uint N>(config: Config<N>, ready: bool, read_bit: Option<bool>, is_last: bool, byte: uint<8>, i: uint<4>) -> S<N> {
    if i < 8 {
        let byte = match read_bit {
            Some(bit) => if bit { 1 } else { 0 } | (byte << 1),
            None => byte,
        };
        S {
            req: Some(by_bit::Req::ReadBit),
            ready: false,
            status: if read_bit.is_some() && i == 7 {
                Some(Status::ReadByte(byte))
            } else {
                None
            },
            next_state: if !ready {
                State::ReadByte(byte, i)
            } else {
                State::ReadByte(byte, i +. 1)
            },
        }
    } else {
        S {
            req: Some(by_bit::Req::WriteBit(is_last)),
            ready,
            status: None,
            next_state: if !ready {
                State::ReadByte(byte, i)
            } else {
                State::Idle
            }
        }
    }
}

fn s_restart<#uint N>(config: Config<N>, ready: bool, read_bit: Option<bool>, addr_rw: AddrRw, state: StartState) -> S<N> {
    let s = s_start_common(config, ready, read_bit, addr_rw, state, by_bit::Req::Restart);
    S {
        req: s.req,
        ready: s.ready,
        status: s.status,
        next_state: match s.next_state {
            Some(start_state) => State::Restart(start_state),
            None => State::Idle
        },
    }
}

fn s_stop<#uint N>(config: Config<N>, ready: bool) -> S<N> {
    S {
        req: Some(by_bit::Req::Stop),
        ready,
        status: None,
        next_state: if ready {
            State::Idle
        } else {
            State::Stop
        },
    }
}

pub entity i2c_controller<#uint N>(
    clk: clock,
    rst: bool,
    // If in output, don't care
    sda: bool,
    // If in output, don't care
    scl: bool,
    req: Rv<Req>,
    config: Config<N>,
) -> Output {
    let Rv { _data: req, ready } = req;
    let (by_bit_ready, by_bit_ready_inv) = port();
    decl state;
    decl read_bit;
    let s = match (state, req) {
        // Handle idle with no request
        (State::Idle, None) => S {
            req: None,
            ready: false,
            next_state: State::Idle,
            status: None,
        },
        // Handle existing requests
        (State::Start { state }, Some(Req::Start { addr_rw })) => s_start(config, by_bit_ready, read_bit, addr_rw, state),
        (State::WriteByte { i }, Some(Req::WriteByte { byte })) => s_write_byte(config, by_bit_ready, read_bit, byte, i),
        (State::ReadByte { byte, i }, Some(Req::ReadByte { is_last })) => s_read_byte(config, by_bit_ready, read_bit, is_last, byte, i),
        (State::Restart { state }, Some(Req::Restart { addr_rw })) => s_restart(config, by_bit_ready, read_bit, addr_rw, state),
        (State::Stop, Some(Req::Stop)) => s_stop(config, by_bit_ready),
        // Handle new requests
        (_, Some(Req::Start { addr_rw })) => s_start(config, by_bit_ready, read_bit, addr_rw, StartState::Start),
        (_, Some(Req::WriteByte { byte })) => s_write_byte(config, by_bit_ready, read_bit, byte, 0),
        (_, Some(Req::ReadByte { is_last })) => s_read_byte(config, by_bit_ready, read_bit, is_last, 0, 0),
        (_, Some(Req::Restart { addr_rw })) => s_restart(config, by_bit_ready, read_bit, addr_rw, StartState::Start),
        (_, Some(Req::Stop)) => s_stop(config, by_bit_ready),
        // unreachable
        _ => S {
            req: None,
            ready: false,
            next_state: State::Idle,
            status: None,
        }
    };
    reg(clk) state reset(rst: State::Idle) = s.next_state;
    let o = inst i2c_controller_by_bit(clk, rst, sda, scl, Rv(s.req, by_bit_ready_inv), config);
    let read_bit = o.read_bit;
    set ready = s.ready;
    Output {
        sda: o.sda,
        scl: o.scl,
        status: s.status,
    }
}

entity i2c_controller_th(
    clk: clock,
    rst: bool,
    // If in output, don't care
    sda: bool,
    // If in output, don't care
    scl: bool,
    req: Rv<Req>,
    config: Config<7>,
) -> Output {
    inst i2c_controller(clk, rst, sda, scl, req, config)
}
